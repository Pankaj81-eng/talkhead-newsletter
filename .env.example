# Copy this file to .env and fill in your own keys.
# Every one of these has a free tier. See README.md for where to get each.

# --- LLM (script generation) ---
GEMINI_API_KEY=
GROQ_API_KEY=

# --- B-roll (optional — falls back through video -> photo -> text card as
# each source is unset/misses; with none of these set, every beat is a
# text card) ---
PEXELS_API_KEY=
PIXABAY_API_KEY=
# Coverr free tier: 50 requests/hour (Demo status). Get a key at
# coverr.co/developers. Tried only after Pexels and Pixabay both miss.
COVERR_API_KEY=

# --- Duration budget (seconds) ---
FACTORY_MIN_SECONDS=60
FACTORY_SAFE_MAX_SECONDS=85
FACTORY_HARD_MAX_SECONDS=90
FACTORY_WORDS_PER_SECOND=2.4

# Per-story curated b-roll: point this at a folder with real footage +
# manifest.json (see assets/official/gpt6-astra/ for the format) and any
# beat whose broll query matches a tag gets that real clip instead of
# stock search. Story-specific -- update or blank this out per run.
FACTORY_OFFICIAL_BROLL_DIR=

# --- Voice engine ---
FACTORY_VOICE_ENGINE=kokoro
# Chatterbox is stochastic -- leave unset for a fresh random take, or pin
# a seed (printed by every run) once you find one that sounds right.
FACTORY_VOICE_SEED=
# Pace: 1.15 = 15% faster, pitch-preserving. Try 1.1-1.2. 1.0 disables it.
FACTORY_VOICE_SPEED=1.15

# --- Telegram (needed for `factory telegram-bot`, i.e. Gate 1 / Gate 2
# approvals over chat) ---
# IMPORTANT: create a NEW bot via @BotFather dedicated to this project --
# do not reuse techtales-factory's bot token. Two processes polling the
# same token can race for updates, and this project had a real incident
# where a stale gate on a long-running bot let an unrelated later message
# trigger an accidental action. Get your chat ID by messaging the new bot
# once, then GET api.telegram.org/bot<token>/getUpdates and read chat.id.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Publishing (Phase 0: leave ALL of this blank on purpose) ---
# Approving Gate 2 calls publish_video(), which publishes to whatever of
# YouTube/Instagram/LinkedIn has credentials set below -- if a platform's
# keys are blank, that platform just records an error and the video still
# saves locally; nothing crashes, nothing goes out. That's exactly what we
# want for the Phase 0 pilot: Gate 2 approval means "this is good, I'll
# post it myself" -- not "publish it automatically." Don't fill these in
# until you've deliberately decided to turn on real auto-publishing.
YT_CLIENT_ID=
YT_CLIENT_SECRET=
YT_REFRESH_TOKEN=
IG_USER_ID=
IG_ACCESS_TOKEN=
S3_BUCKET=
S3_ENDPOINT=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
ASSET_BASE_URL=
WOOP_API_KEY=
WOOP_PROJECT_ID=
WOOP_LINKEDIN_ACCOUNT_ID=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
TIKTOK_REFRESH_TOKEN=
FB_PAGE_ID=
FB_PAGE_ACCESS_TOKEN=
